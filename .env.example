SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=.railway.app,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# Railway Postgres exposes DATABASE_URL automatically when you add a Postgres service.
DATABASE_URL=
DB_SSL_REQUIRE=False

# Optional persistent media storage. Recommended if users upload files.
CLOUDINARY_URL=

# Optional security overrides. Defaults are production-safe when DEBUG=False.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
